// This is the complete schema.prisma file with all models

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// All Enums
enum Status {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum ProjectRole {
  BACKEND_DEVELOPER
  FULLSTACK_DEVELOPER
  FRONTEND_DEVELOPER
  DESIGNER
  RESEARCHER
  CONTRIBUTOR
  PROJECT_MANAGER
  TESTER
}

enum TeamRole {
  LEADER
  MEMBER
  MENTOR
}

enum RecommendationType {
  TECHNOLOGY_SUGGESTION
  TASK_ALLOCATION_ADVICE
  RESOURCE_RECOMMENDATION
  BEST_PRACTICE_TIP
  DEBUGGING_HELP
  SUBMISSION_IMPROVEMENT_SUGGESTION
  TIMELINE_ADJUSTMENT_PROPOSAL
  TEAM_FORMATION_SUGGESTION
  MENTORSHIP_SUGGESTION
  CODE_REVIEW_SUGGESTION
}

enum EducationType {
  SCHOOL
  COLLEGE
}

enum HackathonExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum WorkStyle {
  COLLABORATIVE
  INDEPENDENT
  FLEXIBLE
}

enum BadgeRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

// Core User Model
model User {
  id                      String                   @id @default(uuid())
  email                   String                   @unique
  name                    String
  aiInteractionPrefs      Json?
  availability            Json?
  avatarUrl              String?
  bio                    String?
  createdAt              DateTime                 @default(now())
  experience             Json?
  githubId               String?                  @unique
  githubStats            Json?
  googleId               String?                  @unique
  interests              String[]
  isEmailVerified        Boolean                  @default(false)
  lastLogin              DateTime?
  linkedinId             String?                  @unique
  password               String?
  status                 String                   @default("active")
  timeZone               String?
  updatedAt              DateTime                 @updatedAt
  gitHubAccessToken      String?
  gitHubRefreshToken     String?
  googleAccessToken      String?
  googleRefreshToken     String?
  verificationToken      String?
  verificationTokenExpiry DateTime?

  // New Profile Fields
  tagline                String?
  resumeUrl             String?
  linkedinUrl           String?
  githubUrl             String?
  portfolioUrl          String?
  twitterUrl           String?
  devfolioUrl          String?
  unstopUrl            String?

  // Relations
  tasksAssigned          Task[]                   @relation("TaskAssignee")
  teams                  Team[]
  aiRecommendations      AIRecommendation[]       @relation("UserRecommendations")
  comments               Comment[]
  eventLogs              EventLog[]
  githubContributions    GitHubContribution[]
  mentorshipsReceived    Mentorship[]             @relation("MentorshipsReceived")
  mentorshipsGiven       Mentorship[]             @relation("MentorshipsGiven")
  mentorships            Mentorship[]
  notificationPreference NotificationPreference?
  notifications          Notification[]
  progressUpdates        ProgressUpdate[]         @relation("UserProgressUpdates")
  projectMembers         ProjectMember[]
  recommendationFeedback RecommendationFeedback[]
  teamMemberships        TeamMember[]
  hackathons             Hackathon[]              @relation("UserHackathons")
  skills                 Skill[]                  @relation("UserSkills")
  
  // New Relations
  education              Education[]
  userProjects           UserProject[]
  positions              Position[]
  workExperiences        WorkExperience[]
  achievements           Achievement[]
  certificates           Certificate[]
  hackathonPreference    HackathonPreference?
  userBadges             UserBadge[]
  contexts               Context[]
  commits                Commit[]
}

// Existing Core Models
model Skill {
  id        String    @id @default(uuid())
  name      String    @unique
  category  String?
  projects  Project[] @relation("ProjectTechnologies")
  teams     Team[]    @relation("TeamSkillsNeeded")
  users     User[]    @relation("UserSkills")
}

model Team {
  id                String       @id @default(uuid())
  teamCode         String       @unique
  name             String
  description      String?
  lookingForMembers Boolean     @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  leaderId         String
  hackathon        Hackathon?
  project          Project?
  tasks            Task[]       @relation("TeamTasks")
  leader           User         @relation(fields: [leaderId], references: [id])
  members          TeamMember[]
  skillsNeeded     Skill[]      @relation("TeamSkillsNeeded")
}

model Hackathon {
  id           String              @id @default(uuid()) @db.Uuid
  name         String
  description  String?
  startDate    String
  endDate      String
  location     String?
  rules        String?
  prizeDetails Json?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  aiInsights   Json?
  domains      String[]
  teamId       String?             @unique
  team         Team?               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  timeline     HackathonTimeline[] @relation("HackathonTimeline")
  users        User[]              @relation("UserHackathons")
}

// New Profile-Related Models
model Education {
  id             String        @id @default(uuid())
  userId         String
  type           EducationType
  instituteName  String
  fieldOfStudy   String?
  degree         String?
  grade          Float?
  startYear      Int
  endYear        Int?
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("education")
}

model UserProject {
  id               String    @id @default(uuid())
  userId           String
  title            String
  description      String?   // Make this optional
  technologiesUsed String[]
  deployedUrl      String?
  repoUrl          String?
  startDate        DateTime
  endDate          DateTime?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_projects")
}

model Position {
  id           String    @id @default(uuid())
  userId       String
  position     String
  organization String
  startDate    DateTime
  endDate      DateTime?
  description  String?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("positions")
}

model WorkExperience {
  id             String   @id @default(uuid())
  userId         String
  companyName    String
  role           String
  position       String
  employmentType String
  startDate      DateTime
  endDate        DateTime?
  description    String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("work_experiences")
}

model Achievement {
  id                  String   @id @default(uuid())
  userId              String
  title               String
  description         String?
  date                DateTime
  type                String
  issuingOrganization String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("achievements")
}

model Certificate {
  id                   String    @id @default(uuid())
  userId               String
  name                 String
  issuingOrganization String
  date                 DateTime
  credentialUrl        String?
  description          String?
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("certificates")
}

model HackathonPreference {
  id                      String                   @id @default(uuid())
  userId                  String                   @unique
  rolePreferences         String[]    // Array of ProjectRole enum values
  domainInterests         String[]
  experienceLevel         HackathonExperienceLevel
  hackathonsParticipated Int                      @default(0)
  teamSize               Int?
  communicationPreference String?
  workStyle              WorkStyle
  typicalAvailability    String?
  weeklyCommitment       Int?    // hours per week
  user                   User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("hackathon_preferences")
}

// Badge System
model Badge {
  id           String      @id @default(uuid())
  name         String      @unique
  description  String
  icon         String      // Store icon name or URL
  color        String
  gradientFrom String?
  gradientTo   String?
  category     String
  rarity       BadgeRarity
  image        String
  userBadges   UserBadge[]

  @@map("badges")
}

model UserBadge {
  id         String    @id @default(uuid())
  userId     String
  badgeId    String
  earnedDate DateTime  @default(now())
  progress   Int       @default(0)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge      Badge     @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("user_badges")
}

// Resources System
model Resource {
  id          String         @id @default(uuid())
  title       String
  description String?
  url         String
  category    String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  items       ResourceItem[] // Add this relation field to link ResourceItems

  @@map("resources")
}


model ResourceItem {
  id          String    @id @default(uuid())
  resourceId  String
  name        String
  description String
  link        String
  resource    Resource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@map("resource_items")
}

// Tracking and Progress
model Context {
  id       String @id @default(uuid())
  userId   String
  progress Float  @default(0)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("contexts")
}

model Commit {
  id      String @id @default(uuid())
  message String
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("commits")
}

// Existing Project Management Models
model Project {
  id                       String               @id @default(uuid())
  name                     String
  description             String?
  teamId                  String               @unique
  hackathonId             String?              @db.Uuid
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  totalCommits            Int                  @default(0)
  totalPRs                Int                  @default(0)
  totalIssues             Int                  @default(0)
  efficiencyScore         Float?
  codeQuality             Float?
  aiGeneratedDocs         Json?
  aiImprovementSuggestions Json?
  keyInnovations          Json?
  memberContributions     Json?
  technologyStack         String[]
  problemStatement        String?
  solutionOverview        String?
  repositoryUrl           String?
  submissionUrl           String?
  team                    Team?                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  tasks                   Task[]               @relation("ProjectTasks")
  aiRecommendations       AIRecommendation[]
  eventLogs               EventLog[]
  githubContributions     GitHubContribution[]
  notifications           Notification[]
  progressUpdates         ProgressUpdate[]     @relation("ProjectProgressUpdates")
  projectAssessment       ProjectAssessment?
  members                 ProjectMember[]
  report                  ProjectReport?
  submissionFeedback      SubmissionFeedback?
  timelineSuggestions     TimelineSuggestion[]
  technologies            Skill[]              @relation("ProjectTechnologies")
}

// Continuing with existing models...
model Task {
  id                 String               @id @default(uuid())
  projectId          String?
  title              String
  description        String?
  status             Status               @default(PENDING)
  assigneeId         String?
  priority           TaskPriority         @default(MEDIUM)
  dueDate            DateTime
  estimatedTime      Float?
  actualTime         Float?
  dependencies       String[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  teamId             String
  difficulty         Difficulty           @default(MEDIUM)
  aiSuggestion       Boolean              @default(false)
  assignedTo         String?
  checkList          CheckListItem[]
  assignee           User?                @relation("TaskAssignee", fields: [assigneeId], references: [id])
  project            Project?             @relation("ProjectTasks", fields: [projectId], references: [id], onDelete: Cascade)
  team               Team                 @relation("TeamTasks", fields: [teamId], references: [id], onDelete: Cascade)
  aiRecommendations  AIRecommendation[]
  comments           Comment[]
  eventLogs          EventLog[]
  notifications      Notification[]
  conflictingTask1   TaskConflict[]       @relation("ConflictingTask1")
  conflictingTask2   TaskConflict[]       @relation("ConflictingTask2")
  taskConflicts      TaskConflict[]
  timelineSuggestions TimelineSuggestion[]
}

model HackathonTimeline {
  id          String     @id @default(uuid())
  hackathonId String?    @db.Uuid
  eventName   String
  eventTime   DateTime
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  hackathon   Hackathon? @relation("HackathonTimeline", fields: [hackathonId], references: [id], onDelete: Cascade)
}

model CheckListItem {
  id        String  @id @default(uuid())
  taskId    String
  status    String  @default("in-progress")
  rank      Int
  text      String
  completed Boolean @default(false)
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Comment {
  id        String   @id @default(uuid())
  taskId    String?
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model ProgressUpdate {
  id        String   @id @default(uuid())
  userId    String
  projectId String
  content   String
  createdAt DateTime @default(now())
  project   Project  @relation("ProjectProgressUpdates", fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation("UserProgressUpdates", fields: [userId], references: [id], onDelete: Cascade)

  @@map("progress_updates")
}

model ProjectReport {
  id        String   @id @default(uuid())
  projectId String   @unique
  content   String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_reports")
}

model ProjectMember {
  userId    String
  projectId String
  role      ProjectRole @default(CONTRIBUTOR)
  joinedAt  DateTime    @default(now())
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([userId, projectId])
  @@map("project_members")
}

model TeamMember {
  userId   String
  teamId   String
  role     TeamRole @default(MEMBER)
  joinedAt DateTime @default(now())
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([userId, teamId])
  @@map("team_members")
}

model AIRecommendation {
  id              String                   @id @default(uuid())
  projectId       String
  type            RecommendationType
  content         Json
  createdAt       DateTime                 @default(now())
  userId          String?
  taskId          String?
  confidenceScore Float?
  project         Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task            Task?                    @relation(fields: [taskId], references: [id])
  user            User?                    @relation("UserRecommendations", fields: [userId], references: [id])
  feedback        RecommendationFeedback[]

  @@map("ai_recommendations")
}

model RecommendationFeedback {
  id               String           @id @default(uuid())
  recommendationId String
  userId           String
  timestamp        DateTime         @default(now())
  isHelpful        Boolean?
  comment          String?
  recommendation   AIRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("recommendation_feedback")
}

model GitHubContribution {
  id        String   @id @default(uuid())
  userId    String
  projectId String
  type      String
  action    String?
  url       String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("github_contributions")
}

model NotificationPreference {
  id       String  @id @default(uuid())
  userId   String  @unique
  discord  Boolean @default(false)
  slack    Boolean @default(false)
  telegram Boolean @default(false)
  email    Boolean @default(true)
  settings Json?
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  channel   String
  message   String
  sentAt    DateTime @default(now())
  isRead    Boolean  @default(false)
  projectId String?
  taskId    String?
  project   Project? @relation(fields: [projectId], references: [id])
  task      Task?    @relation(fields: [taskId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model SubmissionFeedback {
  id        String   @id @default(uuid())
  projectId String   @unique
  feedback  Json?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("submission_feedback")
}

model Mentorship {
  id        String    @id @default(uuid())
  mentorId  String
  menteeId  String
  startDate DateTime  @default(now())
  endDate   DateTime?
  notes     String?
  userId    String?
  mentee    User      @relation("MentorshipsReceived", fields: [menteeId], references: [id], onDelete: Cascade)
  mentor    User      @relation("MentorshipsGiven", fields: [mentorId], references: [id], onDelete: Cascade)
  User      User?     @relation(fields: [userId], references: [id])

  @@map("mentorships")
}

model TimelineSuggestion {
  id               String    @id @default(uuid())
  projectId        String
  taskId           String?
  suggestedDueDate DateTime?
  reasoning        String?
  createdAt        DateTime  @default(now())
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task             Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("timeline_suggestions")
}

model TaskConflict {
  id                  String    @id @default(uuid())
  task1Id             String
  task2Id             String
  description         String?
  suggestedResolution Json?
  resolved            Boolean   @default(false)
  resolvedAt          DateTime?
  taskId              String?
  task1               Task      @relation("ConflictingTask1", fields: [task1Id], references: [id], onDelete: Cascade)
  task2               Task      @relation("ConflictingTask2", fields: [task2Id], references: [id], onDelete: Cascade)
  Task                Task?     @relation(fields: [taskId], references: [id])

  @@map("task_conflicts")
}

model ProjectAssessment {
  id             String   @id @default(uuid())
  projectId      String   @unique
  readinessScore Float?
  feedback       Json?
  assessedAt     DateTime @default(now())
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_assessments")
}

model EventLog {
  id        String    @id @default(uuid())
  timestamp DateTime  @default(now())
  eventType String
  userId    String?
  projectId String?
  taskId    String?
  details   Json?
  project   Project?  @relation(fields: [projectId], references: [id])
  task      Task?     @relation(fields: [taskId], references: [id])
  user      User?     @relation(fields: [userId], references: [id])

  @@map("event_logs")
}